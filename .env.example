# Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database Configuration (SQLite default for zero-friction local setup, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./issue_to_pr.db
SYNC_DATABASE_URL=sqlite:///./issue_to_pr.db

# Security
SECRET_KEY=generate_a_random_32_character_secret_key_here

# GitHub Integration (Optional - Demo mode works offline without keys)
# Generate from GitHub Settings -> Developer Settings -> Personal Access Tokens (repo scope)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_API_BASE=https://api.github.com

# AI Provider Selection (Options: mock, openai, anthropic, gemini)
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration
GEMINI_API_KEY=AIza_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Sandbox Execution & Safety Limits
SANDBOX_TIMEOUT_SECONDS=60
MAX_CORRECTION_ATTEMPTS=3
